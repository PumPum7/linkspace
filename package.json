{
  "name": "linkspace",
  "version": "1.0.0",
  "description": "Organize and manage links using workspaces and modes",
  "type": "module",
  "scripts": {
    "dev": "bun run config/build.ts --watch",
    "build": "bun run config/build.ts",
    "pack": "bun run build && cd dist && zip -r ../linkspace.zip .",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.19",
    "@types/chrome": "^0.0.315",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.8.3"
  }
}
